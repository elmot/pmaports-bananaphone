# Maintainer:
pkgname=nokia-ui
pkgver=0.1.0
pkgrel=7
pkgdesc="Minimal Python + Slint KMS/DRM UI for Nokia 8110 4G"
url="https://postmarketos.org"
arch="noarch"
license="GPL-2.0-only"
options="!check"
depends="font-dejavu font-terminus py3-slint"
subpackages="$pkgname-openrc"
install="$pkgname-openrc.post-install"
source="
	85-nokia-ui.preset
	main.py
	main.slint
	nokia-ui.initd
	nokia-ui.service
	nokia-ui-openrc.post-install
"
builddir="$srcdir"

package() {
	install -Dm755 "$builddir/main.py" \
		"$pkgdir/usr/share/nokia-ui/main.py"
	install -Dm644 "$builddir/main.slint" \
		"$pkgdir/usr/share/nokia-ui/main.slint"
	install -Dm644 "$builddir/nokia-ui.service" \
		"$pkgdir/usr/lib/systemd/system/nokia-ui.service"
	install -Dm644 "$builddir/85-nokia-ui.preset" \
		"$pkgdir/usr/lib/systemd/system-preset/85-nokia-ui.preset"
	install -dm755 "$pkgdir/usr/lib/systemd/system/multi-user.target.wants"
	ln -s ../nokia-ui.service \
		"$pkgdir/usr/lib/systemd/system/multi-user.target.wants/nokia-ui.service"
}

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	install="$subpkgname.post-install"
	install -Dm755 "$builddir/nokia-ui.initd" \
		"$subpkgdir/etc/init.d/nokia-ui"
}
