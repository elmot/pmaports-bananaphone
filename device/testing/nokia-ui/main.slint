export component Demo inherits Window {
    width: 240px;
    height: 320px;
    background: #101820;
    in-out property <int> selected: 0;
    in-out property <int> count: 0;

    forward-focus: fs;
    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.UpArrow) {
                root.selected = Math.max(0, root.selected - 1);
                return accept;
            }
            if (ev.text == Key.DownArrow) {
                root.selected = Math.min(2, root.selected + 1);
                return accept;
            }
            if (ev.text == Key.Return) {
                root.count += 1;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 16px;
            spacing: 12px;
            Text {
                text: "Slint Keypad Demo";
                color: #00e5ff;
                font-size: 16px;
                horizontal-alignment: center;
            }
            Text {
                text: "Activated: " + root.count;
                color: #ffffff;
                font-size: 13px;
                horizontal-alignment: center;
            }
            for item[idx] in ["Answer Call", "Loudspeaker", "Settings"]: Rectangle {
                height: 44px;
                border-radius: 6px;
                background: idx == root.selected ? #005577 : #1e2a36;
                border-width: idx == root.selected ? 2px : 0px;
                border-color: #00e5ff;
                Text {
                    text: item;
                    color: #ffffff;
                    font-size: 14px;
                }
            }
        }
    }
}
