export component Demo inherits Window {
    width: 240px;
    height: 320px;
    background: #101820;
    in-out property <int> selected: 0;
    in-out property <int> count: 0;
    in-out property <bool> bt_connected: false;
    in-out property <string> call_state: "idle";
    in-out property <string> caller_id: "";

    forward-focus: fs;
    fs := FocusScope {
        key-pressed(ev) => {
            if (ev.text == Key.UpArrow) {
                root.selected = Math.max(0, root.selected - 1);
                return accept;
            }
            if (ev.text == Key.DownArrow) {
                root.selected = Math.min(2, root.selected + 1);
                return accept;
            }
            if (ev.text == Key.Return) {
                root.count += 1;
                return accept;
            }
            return reject;
        }

        VerticalLayout {
            padding: 12px;
            spacing: 8px;

            HorizontalLayout {
                alignment: center;
                height: 36px;
                Path {
                    width: 36px;
                    height: 36px;
                    commands: "M 18 2 L 23 13 L 35 13 L 25 21 L 29 33 L 18 25 L 7 33 L 11 21 L 1 13 L 13 13 Z";
                    fill: root.call_state == "incoming" ? #ff5252 : #00e5ff;
                    stroke: #ffffff;
                    stroke-width: 1.5px;
                }
            }

            Text {
                text: root.call_state == "incoming" ? "Incoming: " + root.caller_id : "Slint Skia Path Demo";
                color: root.call_state == "incoming" ? #ff5252 : #00e5ff;
                font-size: 15px;
                horizontal-alignment: center;
            }
            Text {
                text: "BT: " + (root.bt_connected ? "Connected" : "Idle") + " | Act: " + root.count;
                color: #ffffff;
                font-size: 12px;
                horizontal-alignment: center;
            }
            for item[idx] in ["Answer Call", "Loudspeaker", "Settings"]: Rectangle {
                height: 40px;
                border-radius: 6px;
                background: idx == root.selected ? #005577 : #1e2a36;
                border-width: idx == root.selected ? 2px : 0px;
                border-color: #00e5ff;
                Text {
                    text: item;
                    color: #ffffff;
                    font-size: 14px;
                }
            }
        }
    }
}
