[Unit]
Description=Nokia 8110 4G Slint UI (KMS/DRM)
After=rc-local.service plymouth-quit-wait.service systemd-user-sessions.service dbus.socket bluetooth.service
Conflicts=getty@tty1.service
After=getty@tty1.service

[Service]
Type=simple
User=10000
Group=10000
PAMName=login
SupplementaryGroups=input video audio wheel
WorkingDirectory=/home/elmot
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
Environment=SLINT_BACKEND=linuxkms-software
Environment=XDG_RUNTIME_DIR=/run/user/10000
ExecStartPre=-/bin/sh -c 'echo 14 > /sys/class/backlight/backlight/brightness'
ExecStart=/usr/bin/python3 /usr/share/nokia-ui/main.py
Restart=always
RestartSec=1

[Install]
WantedBy=multi-user.target
Alias=display-manager.service
