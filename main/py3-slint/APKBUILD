# Maintainer:
pkgname=py3-slint
pkgver=1.10.0
pkgrel=0
pkgdesc="Python bindings for the Slint UI toolkit"
url="https://slint.dev/"
arch="armv7 aarch64 x86_64"
license="GPL-3.0-only"
depends="
	libxkbcommon
	mesa-egl
	python3
	wayland-libs-client
"
makedepends="
	cargo
	libxkbcommon-dev
	maturin
	mesa-dev
	py3-gpep517
	py3-installer
	python3-dev
	wayland-dev
"
options="!check net" # cargo fetches crates during build
source="slint-$pkgver.tar.gz::https://github.com/slint-ui/slint/archive/refs/tags/v$pkgver.tar.gz"
builddir="$srcdir/slint-$pkgver"

build() {
	cd "$builddir/api/python/slint"
	maturin build \
		--release \
		--strip \
		--out "$builddir/dist"
}

package() {
	python3 -m installer -d "$pkgdir" \
		"$builddir"/dist/*.whl
}

# Run `pmbootstrap checksum py3-slint` to populate sha512sums
sha512sums=""

